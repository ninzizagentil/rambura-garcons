PORT=5000
# development = local work; production = the live site (docker-compose already forces production).
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/rambura_garcons

# Generate strong, unique values for these two before deploying to production.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30
# Sign users out after this many minutes without activity.
SESSION_IDLE_MINUTES=30
# Number of proxies in front of the API (1 when behind nginx / a load balancer, 0 when not).
TRUST_PROXY=0

# E-mail (password reset, contact form, admission updates, alerts).
# Mail is only sent when SMTP_HOST, SMTP_USER and SMTP_PASSWORD are ALL filled in.
# Gmail: SMTP_USER = your Gmail address, SMTP_PASSWORD = a 16-character "App Password"
# (Google Account > Security > 2-Step Verification > App passwords) - NOT your normal password.
# The admin "Settings" screen can also save SMTP settings; those win over these lines when complete.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_EMAIL=info@rambura-garcons.rw

# Database backups: how often, and how many files to keep (older ones are deleted).
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Optional: key used to encrypt the SMTP password saved from the admin Settings screen.
# If empty, it is derived from JWT_REFRESH_SECRET (changing that secret then clears the saved password).
SETTINGS_ENCRYPTION_KEY=
