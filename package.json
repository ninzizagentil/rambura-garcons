{
  "name": "rambura-garcons",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test \"src/**/*.test.js\"",
    "dev": "npm run --silent dev:all",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend run --silent dev",
    "dev:all": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run --silent dev:frontend\" \"npm run --silent dev:backend\"",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend test",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.63.0",
    "vite": "^8.2.0"
  }
}
